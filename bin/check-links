#!/usr/bin/env ruby
# Check the links of the huts' cards (« Site du refuge », « Résa » (icône calendrier), see MapData.links): each one
# must answer, and a booking page of the FFCAM centrale must show this hut. Also the links written in
# the pages themselves (<a href="https://..."> of templates/*.html: FFCAM guide, GitHub, map credits). Weekly (workflow
# links.yml, started by cron-job.org) or by hand after bin/refresh-huts. About 250 requests,
# with the same politeness limits as the availability fetch.
#
#   bin/check-links                # print the problems
#   bin/check-links --history      # also write history/links.json (shown on /releves/) and
#                                    # sync the GitHub issue « Liens cassés » (with GITHUB_TOKEN)
#
# Per link: ok; warn (answers, but the page doesn't name this hut: booking page without the
# centrale widget, closed for works...; or 401 / 403 / 429: the site refuses robots, as some do
# with GitHub Actions' addresses); err (no answer, other HTTP error, an unknown <name>.ffcam.fr
# site sent to www.ffcam.fr). Only errors go into the issue.

require "fileutils"
require "json"
require "optparse"
require "uri"
require_relative "../lib/couchette"
require_relative "../lib/map_data"
require_relative "../lib/github_issues"

module LinkCheck
  module_function

  FILE = File.join(Couchette::ROOT, "history", "links.json")

  # [{id, name, kind ("site" / "booking"), url}] for every hut of catalog/huts.json
  def targets(huts, coords, overrides = MapData.load_booking_links)
    huts.flat_map do |h|
      site, booking = MapData.links(h, MapData.hut_url(h, coords.dig(h["id"], "website")), overrides)
      name = h["name"].gsub("  ", " ").gsub(" (FFCAM)", "")
      [["site", site], ["booking", booking]].select { |_, u| u }.map { |k, u| { "id" => h["id"], "name" => name, "kind" => k, "url" => u } }
    end
  end

  TEMPLATES_DIR = File.join(Couchette::ROOT, "templates")
  PAGES = { "map" => "Carte", "a-propos" => "À propos", "releves" => "Relevés", "login" => "Connexion" }.freeze

  # [{id, name, kind "page", url}]: the external links (<a href="https://...">) of the site's pages.
  # Only anchors: stylesheets, fonts, tiles and the feedback form's API are not pages people open.
  def page_targets(dir = TEMPLATES_DIR)
    Dir[File.join(dir, "*.html")].sort.flat_map do |file|
      page = File.basename(file, ".html")
      File.read(file, encoding: "UTF-8").scan(/<a\b[^>]*\bhref="(https?:\/\/[^"$`{}]+)"/).flatten.uniq.map do |url|
        { "id" => "page:#{page}", "name" => "Page « #{PAGES.fetch(page, page)} »", "kind" => "page", "url" => url }
      end
    end
  end

  # [state, message] for a link that answered (final URL after redirects, page body)
  def verdict(target, final_url, body)
    url = target["url"]
    if url.include?(".ffcam.fr") && URI(final_url).host == "www.ffcam.fr" && !url.include?("www.ffcam.fr")
      return ["err", "renvoie vers www.ffcam.fr (site inconnu)"]
    end
    if target["kind"] == "booking" && (url.include?("centrale.ffcam.fr") || url.end_with?(".ffcam.fr/reservation.html"))
      short = target["id"].sub("BK_STRUCTURE:", "")
      return ["warn", "la page ne montre pas ce refuge (pas de widget de réservation)"] unless body.include?(short)
    end
    ["ok", ""]
  end

  # [state, message] for a link that didn't answer. 401 / 403 / 429: the site refuses robots
  # (often GitHub Actions' datacenter addresses), the page itself may be fine: only « à vérifier ».
  def failure(error)
    return ["warn", "le site refuse les robots (#{error[/HTTP Error \d+/]}) : à vérifier dans un navigateur"] if error.match?(/HTTP Error (401|403|429)\b/)
    ["err", error[0, 200]]
  end

  def check(targets)
    urls = targets.map { |t| t["url"] }.uniq
    answers = Couchette.pool_map(urls, 6) do |u|
      final, body = Couchette.polite(u) { Couchette.fetch(u, nil, Couchette::HEADERS, 20) }
      [final, body]
    rescue StandardError => e
      Couchette.error_text(e)
    end.then { |list| urls.zip(list).to_h }
    targets.map do |t|
      a = answers[t["url"]]
      state, msg = a.is_a?(String) ? failure(a) : verdict(t, *a)
      t.merge("state" => state, "msg" => msg)
    end
  end

  def summary(results, at)
    counts = %w[ok warn err].to_h { |s| [s, results.count { |r| r["state"] == s }] }
    { "at" => at, "checked" => results.size, "counts" => counts, "problems" => results.reject { |r| r["state"] == "ok" } }
  end

  def issue_body(errors)
    kinds = { "site" => "Site du refuge", "booking" => "Résa", "page" => "Lien de la page" }
    rows = errors.map { |r| "| #{r['name']} | #{kinds.fetch(r['kind'], r['kind'])} | #{r['url']} | #{r['msg'].gsub('|', '/')} |" }
    ["#{errors.size} lien#{errors.size > 1 ? 's' : ''} cassé#{errors.size > 1 ? 's' : ''} sur les fiches des refuges ou les pages du site.", "",
     "| Refuge / page | Lien | URL | Erreur |", "| --- | --- | --- | --- |", *rows, "",
     "À corriger dans `catalog/manual/booking_links.json` (ou `catalog/manual/manual_huts.json` pour un site), ou dans `templates/` pour un lien de page. Détail : https://dernierecouchette.fr/releves/"].join("\n")
  end
end

def main
  history = false
  parser = OptionParser.new do |o|
    o.banner = "Usage: bin/check-links [--history]"
    o.on("--history", "write history/links.json and sync the GitHub issue") { history = true }
  end
  Couchette.parse_args(parser)
  coords_file = File.join(Couchette::CATALOG_DIR, "hut_coordinates.json")
  coords = File.exist?(coords_file) ? JSON.parse(File.read(coords_file, encoding: "UTF-8")) : {}
  results = LinkCheck.check(LinkCheck.targets(Couchette.load_huts["huts"], coords) + LinkCheck.page_targets)
  sum = LinkCheck.summary(results, Couchette.local_now.strftime("%Y-%m-%dT%H:%M:%S"))
  sum["problems"].each { |r| puts "#{r['state'].ljust(4)} #{r['name']} [#{r['kind']}] #{r['url']} — #{r['msg']}" }
  warn "Links: #{sum['checked']} checked, #{sum['counts']}"
  return unless history
  FileUtils.mkdir_p(File.dirname(LinkCheck::FILE))
  File.write(LinkCheck::FILE, Py.dumps(sum, ensure_ascii: false, indent: 1) + "\n")
  errors = results.select { |r| r["state"] == "err" }
  result = GitHubIssues.sync(label: "liens", title: "Liens cassés", body: errors.empty? ? nil : LinkCheck.issue_body(errors),
                             key: errors.map { |r| r["url"] }.sort.join(","))
  warn "Links issue: #{result}"
end

main if $PROGRAM_NAME == __FILE__
